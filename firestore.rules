rules_version = '2';

// Kitchen Command — only these signed-in accounts can read or write anything.
// Add the store iPad email next to the owner email before that iPad is used.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && request.auth.token.email in [
          'vinziant@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
